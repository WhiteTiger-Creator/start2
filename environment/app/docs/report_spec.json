{
  "workflow_repair": {
    "path": "/app/workflow/scheduler.py",
    "cli_usage": "python3 /app/workflow/scheduler.py --input PATH --output-dir PATH",
    "defaults": {
      "input": "/app/data/jobs.json",
      "output_dir": "/app/output",
      "setup_matrix": "/app/data/setup_matrix.json",
      "scheduling_policy": "/app/data/scheduling_policy.json"
    },
    "prohibited_imports": [
      "ortools",
      "pulp",
      "scipy",
      "numpy",
      "networkx",
      "cvxpy",
      "gurobipy",
      "mip"
    ],
    "prohibited_dynamic_execution": [
      "eval",
      "exec",
      "compile"
    ]
  },
  "routing_source": {
    "path": "/app/data/job_routings.json",
    "shape": "{\"jobs\": [{\"id\": str, \"routing\": str, \"family\": str?, \"processing_time\": int?, \"due_date\": int?, \"weight\": int?}, ...], \"precedence\": [[before_id, after_id], ...]}"
  },
  "routing_templates_source": {
    "path": "/app/data/routing_templates.json",
    "shape": "{template_name: {\"extends\": str?, \"family\": str?, \"processing_time\": int?, \"due_date\": int?, \"weight\": int?}, ...}"
  },
  "machine_calendar_source": {
    "path": "/app/data/machine_calendar.json",
    "shape": "{\"calendar_id\": str, \"default_cell_family\": str, \"nominal_operation_time\": int, \"standard_lead_time\": int, \"default_priority_weight\": int}"
  },
  "input_source": {
    "path": "/app/data/jobs.json",
    "shape": "{\"jobs\": [{\"id\": str, \"family\": str, \"processing_time\": int, \"due_date\": int, \"weight\": int}, ...], \"precedence\": [[before_id, after_id], ...]}",
    "coercion": "int(str(x).strip()); on failure int(float(...)); on failure 0. Every id, family and template name via str(...).strip().lower() (empty family -> 'unknown')."
  },
  "setup_source": {
    "path": "/app/data/setup_matrix.json",
    "shape": "{\"initial_family\": str, \"families\": [str, ...], \"setup\": {from_family: {to_family: int, ...}, ...}}"
  },
  "policy_source": {
    "path": "/app/data/scheduling_policy.json",
    "shape": "{\"default\": {field: int, ...}, \"family_overrides\": {family: {field: int, ...}, ...}}",
    "fields": [
      "weight_multiplier",
      "tardiness_grace"
    ]
  },
  "output_files": {
    "schedule_json": "schedule.json",
    "objective_json": "objective.json",
    "summary_json": "summary.json",
    "additional_files_allowed": false
  },
  "field_types": {
    "initial_family": {
      "type": "string"
    },
    "sequence": {
      "type": "array",
      "items": "string",
      "order": "machine-run order, every input job exactly once"
    },
    "weighted_tardiness_by_family": {
      "type": "object",
      "keys": "families present among the jobs",
      "key_sort": "ascending",
      "values": "integer"
    },
    "position": {
      "type": "integer"
    },
    "job_id": {
      "type": "string"
    },
    "setup_from_prev": {
      "type": "integer"
    },
    "start_time": {
      "type": "integer"
    },
    "completion_time": {
      "type": "integer"
    },
    "tardiness": {
      "type": "integer"
    },
    "weighted_tardiness": {
      "type": "integer"
    },
    "job_count": {
      "type": "integer"
    },
    "total_weighted_tardiness": {
      "type": "integer"
    },
    "total_tardiness": {
      "type": "integer"
    },
    "tardy_job_count": {
      "type": "integer"
    },
    "makespan": {
      "type": "integer"
    },
    "total_setup_time": {
      "type": "integer"
    }
  },
  "schedule_json": {
    "output_path": "schedule.json",
    "container": "object",
    "top_level_keys": [
      "sequence",
      "initial_family",
      "placements"
    ],
    "placements_container": "array, one object per job",
    "placements_order": "machine-run (sequence) order",
    "required_fields": [
      "position",
      "job_id",
      "setup_from_prev",
      "start_time",
      "completion_time",
      "tardiness",
      "weighted_tardiness"
    ]
  },
  "objective_json": {
    "output_path": "objective.json",
    "container": "object",
    "schema_version": "sched-wt-v1",
    "required_fields": [
      "schema_version",
      "job_count",
      "sequence",
      "total_weighted_tardiness",
      "makespan",
      "total_setup_time"
    ]
  },
  "summary_json": {
    "output_path": "summary.json",
    "container": "object",
    "schema_version": "sched-wt-v1",
    "required_fields": [
      "schema_version",
      "job_count",
      "total_weighted_tardiness",
      "total_tardiness",
      "tardy_job_count",
      "makespan",
      "weighted_tardiness_by_family"
    ]
  },
  "runtime_budget_seconds": 240
}
